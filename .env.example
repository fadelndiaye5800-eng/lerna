# ============================================================================
# LERNA — variables d'environnement
# NE METS PAS DE VRAIES VALEURS ICI. Ce fichier est un modèle.
# Les vraies valeurs se saisissent dans Vercel → Project → Settings → Environment Variables.
# ============================================================================

# --- Secrètes (serveur uniquement, jamais envoyées au navigateur) ---
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # Supabase → Project Settings → API → service_role
LEMON_SQUEEZY_WEBHOOK_SECRET=...          # Lemon Squeezy → Settings → Webhooks → Signing secret
LEMON_SQUEEZY_API_KEY=...                 # optionnel (gestion avancée des abonnements)
RATE_LIMIT_SALT=une-longue-phrase-aleatoire
ONESIGNAL_REST_API_KEY=...                # OneSignal → Settings → Keys & IDs → REST API Key
CRON_SECRET=une-autre-longue-phrase       # protège la notification quotidienne (Vercel l'envoie tout seul)
RESEND_API_KEY=re_...                     # Resend → API Keys (transfert privé des messages de la page Contact)
CONTACT_FORWARD_TO=ton-adresse-perso@...  # où arrivent les messages de Contact — JAMAIS affichée sur le site
CONTACT_FROM=LERNA <contact@lerna.world>  # expéditeur vérifié dans Resend (une fois le domaine acheté)

# --- Publiques (renvoyées par /api/config, sans danger avec les règles RLS) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...                  # Supabase → Project Settings → API → anon public
LEMON_SQUEEZY_CHECKOUT_MONTHLY=https://lerna.lemonsqueezy.com/buy/...   # lien de paiement 4.99$/mois
LEMON_SQUEEZY_CHECKOUT_YEARLY=https://lerna.lemonsqueezy.com/buy/...    # lien de paiement 39.99$/an
ONESIGNAL_APP_ID=...                      # OneSignal → Settings → Keys & IDs → App ID
APP_URL=https://lerna.world               # adresse du site (liens d'invitation et notifications)
GOOGLE_REVIEW_URL=                        # lien « laisser un avis » de la fiche Google (vide = masqué)
POSTHOG_KEY=phc_...                       # PostHog → Project settings → Project API key (mesures du test A/B)
POSTHOG_HOST=https://eu.i.posthog.com     # serveurs européens de PostHog
CONTACT_PUBLIC_EMAIL=                     # contact@lerna.world une fois le domaine acheté (vide = rien d'affiché)
SHOW_SOCIALS=false                        # true = afficher les réseaux sociaux sur la page Contact
SOCIAL_INSTAGRAM=                         # https://… (codés, affichés seulement si SHOW_SOCIALS=true)
SOCIAL_TIKTOK=
SOCIAL_LINKEDIN=
SOCIAL_X=
SOCIAL_YOUTUBE=

# --- Interrupteur ---
PREMIUM_ENABLED=true                      # false = fonctions Premium ouvertes à tous (phase de lancement)

# Connexion avec Apple : mettre true une fois Apple et Supabase configurés (voir README, section 7b)
APPLE_LOGIN_ENABLED=false
